# NexGenAI — Production Environment Configuration

# Application
PROJECT_NAME="NexGenAI — Campus→Career AI"
ENVIRONMENT=production

# Database (PostgreSQL single source of truth; SQLite automatic dev fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexgenai

# Security
JWT_SECRET=replace-with-a-secure-random-256-bit-secret-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Services
GEMINI_API_KEY=

# File Storage
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# Networking
PORT=8000
FRONTEND_PORT=5173
